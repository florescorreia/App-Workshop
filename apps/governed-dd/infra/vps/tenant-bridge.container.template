[Unit]
Description=Governed DD reviewed tenant mTLS ingress
PartOf=app-governed-dd-${TENANT}.target
After=governed-dd-${TENANT}-governance.service governed-dd-${TENANT}-paperclip.service
Requires=governed-dd-${TENANT}-governance.service governed-dd-${TENANT}-paperclip.service

[Container]
Image=nginx:1.28.0-alpine@sha256:30f1c0d78e0ad60901648be663a710bdadf19e4c10ac6782c235200619158284
ContainerName=governed-dd-${TENANT}-bridge
Network=governed-dd-${TENANT}-ingress.network
PublishPort=127.0.0.1:${TENANT_LOOPBACK_PORT}:9443
Volume=%h/.config/governed-dd/bridge.conf:/etc/nginx/conf.d/default.conf:ro
Volume=%h/.config/governed-dd/bridge-secrets:/run/secrets:ro
PodmanArgs=--memory=128m --cpus=0.25 --pids-limit=128 --security-opt=no-new-privileges

[Service]
Restart=on-failure
TimeoutStopSec=120

[Install]
WantedBy=app-governed-dd-${TENANT}.target
