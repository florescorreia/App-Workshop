# Dedicated tenant ingress bridge; render reviewed IDs, ports and certificates.
# No DB, Bolt, MCP or engine route. Only the trusted control certificate connects.
map $http_upgrade $dd_connection { default upgrade; '' close; }
server {
 listen 9443 ssl;
 ssl_certificate /run/secrets/bridge-cert.pem;
 ssl_certificate_key /run/secrets/bridge-key.pem;
 ssl_client_certificate /run/secrets/control-ca.pem;
 ssl_verify_client on;
 ssl_protocols TLSv1.2 TLSv1.3;
 access_log off;
 client_max_body_size 21m;
 location /dd/api/ { proxy_pass http://governance:8000/api/; }
 location /explorer/ { proxy_pass http://explorer:8080/; }
 location /paperclip/ {
  proxy_pass http://paperclip:3100/;
  proxy_http_version 1.1;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $dd_connection;
  proxy_set_header Host $http_host;
  proxy_set_header Origin $http_origin;
  proxy_read_timeout 130s;
 }
 location /lab/ {
  proxy_pass http://lab:3000/;
  proxy_http_version 1.1;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $dd_connection;
  proxy_set_header Host $http_host;
  proxy_set_header Origin $http_origin;
  proxy_read_timeout 130s;
 }
 location / { return 404; }
}
