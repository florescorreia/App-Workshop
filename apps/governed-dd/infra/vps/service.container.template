[Unit]
Description=Governed DD ${SERVICE} — replace reviewed variables before release
PartOf=${APP_TARGET}
After=${DEPENDENCIES}
Requires=${DEPENDENCIES}

[Container]
Image=${PINNED_IMAGE_DIGEST}
ContainerName=${UNIQUE_CONTAINER_NAME}
Network=${PRIVATE_NETWORK}
EnvironmentFile=${PRIVATE_ENV_PATH}
Volume=${UNIQUE_VOLUME}:${MOUNT_PATH}
PodmanArgs=--memory=${MEMORY_LIMIT} --cpus=${CPU_LIMIT} --pids-limit=256 --security-opt=no-new-privileges

[Service]
Restart=on-failure
TimeoutStartSec=600
TimeoutStopSec=120

[Install]
WantedBy=${APP_TARGET}
