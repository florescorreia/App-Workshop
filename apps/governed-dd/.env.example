DEPLOYMENT_MODE=local
APP_BASE_URL=http://localhost:8081
HOST_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8081
AGENT_MODEL=gpt-6.1-sol
AGENT_REASONING_EFFORT=medium
LLM_AUTH_MODE=api_key
LLM_PROVIDER=litellm
LLM_BASE_URL=https://litellm-app.ambitiousground-51296563.westeurope.azurecontainerapps.io/v1
LLM_API_KEY_ENV=LITELLM_API_KEY
WEB_SEARCH_BACKEND=external
WEB_SEARCH_PROVIDER=bing_rss
WEB_SEARCH_API_KEY_ENV=DD_SEARCH_API_KEY
EMBEDDING_PROVIDER=litellm
EMBEDDING_BASE_URL=https://litellm-app.ambitiousground-51296563.westeurope.azurecontainerapps.io/v1
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
EMBEDDING_API_KEY_ENV=LITELLM_API_KEY
ARTIFACT_BACKEND=filesystem
MAX_CONCURRENT_RUNS_PER_TENANT=1
RUN_TIMEOUT_SECONDS=1800
ALLOW_GENERAL_INTERNET=false
PUBLIC_RESEARCH_AUTHORIZED=false
ENABLE_MEMGRAPH_LAB=false
